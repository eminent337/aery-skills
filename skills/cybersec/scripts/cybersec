/**
 * Safely resolves and validates that an untrusted file path remains strictly
 * confined within the designated base directory.
 * Prevents directory traversal attacks (e.g. '../', absolute path escapes, null bytes).
 */
export function resolveSafePath(baseDir: string, untrustedPath: string): string {
  // Reject null byte injection
  if (untrustedPath.includes("\\0")) {
    throw new Error("Invalid path: null byte detected");
  }

  // Resolve absolute canonical base directory
  const resolvedBase = path.resolve(baseDir);

  // Strip leading separators to prevent treating untrustedPath as an absolute path
  const sanitizedInput = untrustedPath.replace(/^[\\/\\\\]+/, "");
  const resolvedTarget = path.resolve(resolvedBase, sanitizedInput);

  // Compute relative path from base to target
  const relative = path.relative(resolvedBase, resolvedTarget);

  // Check if relative path escapes base directory (starts with '..' or is root escape)
  const isEscape = relative.startsWith("..") || path.isAbsolute(relative);
  if (isEscape) {
    throw new Error(`Path traversal detected: "${untrustedPath}" escapes "${baseDir}"`);
  }

  return resolvedTarget;
}


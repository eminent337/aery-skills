    "timing-safe": {
        "recipe": "timing-safe",
        "title": "Constant-Time Credential Comparison",
        "description": (
            "Mitigates side-channel timing attacks when validating sensitive credentials, cryptographic "
            "hashes, API tokens, and HMAC signatures by using constant-time equality comparisons with buffer length checks."
        ),
        "python": '''import hashlib
import hmac


def safe_string_compare(val_a: str, val_b: str) -> bool:
    """
    Constant-time comparison for sensitive credentials (API tokens, passwords, MACs).
    Guards against side-channel timing attacks.
    Uses hmac.compare_digest and buffer length checks.
    """
    bytes_a = val_a.encode("utf-8")
    bytes_b = val_b.encode("utf-8")

    # Buffer length comparison
    length_equal = len(bytes_a) == len(bytes_b)

    # Hash to fixed 32-byte SHA-256 buffers to prevent timing leaks from length differences
    hash_a = hashlib.sha256(bytes_a).digest()
    hash_b = hashlib.sha256(bytes_b).digest()

    digest_equal = hmac.compare_digest(hash_a, hash_b)
    content_equal = hmac.compare_digest(bytes_a, bytes_b) if length_equal else False

    return length_equal and digest_equal and content_equal


# Example usage:
# is_valid = safe_string_compare(received_api_token, expected_api_token)
''',
        "typescript": '''import * as crypto from "node:crypto";

/**
 * Constant-time string comparison for sensitive credentials (tokens, signatures, keys).
 * crypto.timingSafeEqual requires buffers of identical length; unequal lengths throw RangeError.
 * We hash both inputs to fixed 32-byte SHA-256 buffers to guarantee constant comparison time
 * even across strings of disparate lengths.
 */
export function timingSafeEqualString(a: string, b: string): boolean {
  const bufA = Buffer.from(a, "utf-8");
  const bufB = Buffer.from(b, "utf-8");

  // Buffer length check
  const lengthMatch = bufA.length === bufB.length;

  // Hash to fixed-length 32-byte buffers
  const hashA = crypto.createHash("sha256").update(bufA).digest();
  const hashB = crypto.createHash("sha256").update(bufB).digest();

  const hashMatch = crypto.timingSafeEqual(hashA, hashB);

  // Direct buffer comparison if lengths match
  const contentMatch = lengthMatch ? crypto.timingSafeEqual(bufA, bufB) : false;

  return lengthMatch && hashMatch && contentMatch;
}

// Example usage:
// if (!timingSafeEqualString(authHeader, API_SECRET)) {
//   return res.status(401).send("Unauthorized");
// }
''',
    },
    "rate-limiter": {
        "recipe": "rate-limiter",
        "title": "Sliding Window Rate Limiter",
        "description": (
            "Guards endpoints against brute-force attacks, credential stuffing, and DoS abuse using a thread-safe "
            "sliding window in-memory rate limiter based on request timestamps."
        ),
        "python": '''import collections
import threading
import time


class SlidingWindowRateLimiter:
    """
    Thread-safe in-memory sliding window rate limiter using time.time().
    Maintains a rolling window of request timestamps per key (e.g. IP address or user ID).
    """

    def __init__(self, max_requests: int, window_seconds: float):
        self.max_requests = max_requests
        self.window_seconds = window_seconds
        self.requests: dict[str, collections.deque[float]] = collections.defaultdict(collections.deque)
        self.lock = threading.Lock()

    def is_allowed(self, key: str) -> tuple[bool, dict]:
        """
        Check if request under key is allowed.
        Returns (allowed: bool, stats: dict) with remaining count and retry_after.
        """
        now = time.time()
        window_start = now - self.window_seconds

        with self.lock:
            timestamps = self.requests[key]

            # Purge timestamps outside the active rolling window
            while timestamps and timestamps[0] <= window_start:
                timestamps.popleft()

            count = len(timestamps)
            if count < self.max_requests:
                timestamps.append(now)
                remaining = self.max_requests - len(timestamps)
                return True, {
                    "allowed": True,
                    "remaining": remaining,
                    "limit": self.max_requests,
                    "retry_after": 0,
                }
            else:
                oldest = timestamps[0]
                retry_after = max(0.0, (oldest + self.window_seconds) - now)
                return False, {
                    "allowed": False,
                    "remaining": 0,
                    "limit": self.max_requests,
                    "retry_after": round(retry_after, 2),
                }

    def cleanup(self) -> None:
        """Prune idle keys older than the sliding window."""
        now = time.time()
        window_start = now - self.window_seconds
        with self.lock:
            idle_keys = [k for k, q in self.requests.items() if not q or q[-1] <= window_start]
            for k in idle_keys:
                del self.requests[k]


# Example usage:
# limiter = SlidingWindowRateLimiter(max_requests=100, window_seconds=60)
# allowed, info = limiter.is_allowed(request.client_ip)
# if not allowed:
#     return Response(f"Rate limit exceeded. Retry after {info['retry_after']}s", status_code=429)
''',
        "typescript": '''interface RateLimitResult {
  allowed: boolean;
  remaining: number;
  limit: number;
  retryAfterSeconds: number;
}

/**
 * In-memory sliding window rate limiter using Date.now().
 * Tracks timestamps within rolling window per client identifier (IP, user token, etc.).
 */
export class SlidingWindowRateLimiter {
  private readonly maxRequests: number;
  private readonly windowMs: number;
  private readonly requests: Map<string, number[]> = new Map();

  constructor(maxRequests: number, windowSeconds: number) {
    this.maxRequests = maxRequests;
    this.windowMs = windowSeconds * 1000;
  }

  public isAllowed(key: string): RateLimitResult {
    const now = Date.now();
    const windowStart = now - this.windowMs;

    let timestamps = this.requests.get(key);
    if (!timestamps) {
      timestamps = [];
      this.requests.set(key, timestamps);
    }

    // Filter out timestamps outside current rolling window
    const activeTimestamps = timestamps.filter((t) => t > windowStart);
    this.requests.set(key, activeTimestamps);

    if (activeTimestamps.length < this.maxRequests) {
      activeTimestamps.push(now);
      return {
        allowed: true,
        remaining: this.maxRequests - activeTimestamps.length,
        limit: this.maxRequests,
        retryAfterSeconds: 0,
      };
    }

    const oldest = activeTimestamps[0];
    const retryAfterSeconds = Math.ceil(((oldest + this.windowMs) - now) / 1000);

    return {
      allowed: false,
      remaining: 0,
      limit: this.maxRequests,
      retryAfterSeconds: Math.max(0, retryAfterSeconds),
    };
  }

  public cleanup(): void {
    const now = Date.now();
    const windowStart = now - this.windowMs;
    for (const [key, timestamps] of this.requests.entries()) {
      const active = timestamps.filter((t) => t > windowStart);
      if (active.length === 0) {
        this.requests.delete(key);
      } else {
        this.requests.set(key, active);
      }
    }
  }
}

// Example Express middleware:
// const limiter = new SlidingWindowRateLimiter(60, 60); // 60 req/min
// export function rateLimitMiddleware(req: Request, res: Response, next: NextFunction) {
//   const ip = req.ip || req.socket.remoteAddress || "anonymous";
//   const result = limiter.isAllowed(ip);
//   res.setHeader("X-RateLimit-Limit", result.limit);
//   res.setHeader("X-RateLimit-Remaining", result.remaining);
//   if (!result.allowed) {
//     res.setHeader("Retry-After", result.retryAfterSeconds);
//     return res.status(429).json({ error: "Too Many Requests", retryAfter: result.retryAfterSeconds });
//   }
//   next();
// }
''',
    },
}


def output_patch_recipe(recipe: str, as_json: bool) -> int:
    """Output hardened defensive security recipe in structured JSON or human-readable format."""
    recipe_data = PATCH_RECIPES.get(recipe)
    if not recipe_data:
        sys.stderr.write(f"Error: Unknown patch recipe '{recipe}'.\n")
        return 1

    if as_json:
        print(json.dumps(recipe_data, indent=2))
    else:
        print("=" * 80)
        print(f"Recipe: {recipe_data['title']} ({recipe_data['recipe']})")
        print("=" * 80)
        print("Description:")
        print(recipe_data["description"])
        print()
        print("--- Python Implementation ---")
        print(recipe_data["python"].strip())
        print()
        print("--- TypeScript Implementation ---")
        print(recipe_data["typescript"].strip())
        print()

    return 0


def handle_patch(args) -> int:
    """Handle patch subcommand execution."""
    recipe = args.recipe
    as_json = getattr(args, "json", False)
    return output_patch_recipe(recipe, as_json)


def build_parser() -> argparse.ArgumentParser:
    """Build and configure the command-line argument parser."""
    parser = argparse.ArgumentParser(
        prog="cybersec",
        description="Zero-dependency cybersecurity CLI engine for scanning, dependency auditing, host analysis, triage, and remediation.",
    )

    subparsers = parser.add_subparsers(dest="subcommand", help="Available subcommands")

    # scan subparser: path (positional), --json (flag), --deep (flag)
    scan_parser = subparsers.add_parser(
        "scan",
        help="Run vulnerability, secret, and security policy scans",
    )
    scan_parser.add_argument(
        "path",
        help="Target file or directory path to scan",
    )
    scan_parser.add_argument(
        "--json",
        action="store_true",
        help="Output findings as JSON",
    )
    scan_parser.add_argument(
        "--deep",
        action="store_true",
        help="Enable deep heuristic analysis",
    )

    # deps subparser: manifest (positional), --json (flag)
    deps_parser = subparsers.add_parser(
        "deps",
        help="Audit software dependencies and package manifests for known vulnerabilities",
    )
    deps_parser.add_argument(
        "manifest",
        help="Path to manifest file (package.json, requirements.txt, etc.)",
    )
    deps_parser.add_argument(
        "--json",
        action="store_true",
        help="Output dependency audit findings as JSON",
    )

    # host subparser: --json (flag)
    host_parser = subparsers.add_parser(
        "host",
        help="Audit host configuration, open ports, permissions, and attack surface",
    )
    host_parser.add_argument(
        "--json",
        action="store_true",
        help="Output host audit findings as JSON",
    )

    # triage subparser: logfile (positional), --type (choices=["auto", "web", "auth"], default="auto"), --json (flag)
    triage_parser = subparsers.add_parser(
        "triage",
        help="Triage security findings, assess exploitability, and prioritize remediation",
    )
    triage_parser.add_argument(
        "logfile",
        help="Path to log file to inspect and triage",
    )
    triage_parser.add_argument(
        "--type",
        choices=["auto", "web", "auth"],
        default="auto",
        help="Log type format parser (default: auto)",
    )
    triage_parser.add_argument(
        "--json",
        action="store_true",
        help="Output triage report as JSON",
    )

    # patch subparser: recipe (positional, choices=["safe-path", "sql-param", "security-headers", "timing-safe", "rate-limiter"])
    patch_parser = subparsers.add_parser(
        "patch",
        help="Generate or apply security patches, configuration fixes, and remediations",
    )
    patch_parser.add_argument(
        "recipe",
        choices=[
            "safe-path",
            "sql-param",
            "security-headers",
            "timing-safe",
            "rate-limiter",
        ],
        help="Security remediation recipe to apply or inspect",
    )
    patch_parser.add_argument(
        "--json",
        action="store_true",
        help="Output patch recipe as JSON",
    )

    return parser


def main(argv=None) -> int:
    """Main entrypoint for cybersec CLI."""
    parser = build_parser()

    if argv is None:
        argv = sys.argv[1:]

    if not argv:
        parser.print_help()
        return 0

    args = parser.parse_args(argv)

    if not args.subcommand:
        parser.print_help()
        return 0

    if args.subcommand == "scan":
        return handle_scan(args)

    if args.subcommand == "deps":
        return handle_deps(args)

    if args.subcommand == "host":
        return handle_host(args)

    if args.subcommand == "triage":
        return handle_triage(args)

    if args.subcommand == "patch":
        return handle_patch(args)

    return 0


if __name__ == "__main__":
    sys.exit(main())

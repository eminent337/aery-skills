        ),
        "python": '''import os
from pathlib import Path


def resolve_safe_path(base_dir: str | Path, untrusted_path: str) -> str:
    """
    Safely resolve and validate that untrusted_path stays strictly within base_dir.
    Guards against directory traversal (../), absolute path overrides, and symlink escapes.
    Raises ValueError if target path escapes base_dir.
    """
    # Canonicalize base directory
    base = os.path.realpath(str(base_dir))

    # Sanitize and join relative path (strip leading slashes to prevent root-relative override)
    clean_untrusted = untrusted_path.lstrip("/\\\\")
    target = os.path.realpath(os.path.join(base, clean_untrusted))

    # Common path containment check
    try:
        common = os.path.commonpath([base, target])
    except ValueError:
        # Occurs on Windows if paths are on different drive letters
        raise ValueError(f"Path traversal detected: {untrusted_path!r} escapes {base_dir!r}")

    if common != base:
        raise ValueError(f"Path traversal detected: {untrusted_path!r} escapes {base_dir!r}")

    return target


